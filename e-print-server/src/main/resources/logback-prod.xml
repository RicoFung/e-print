<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="e-print-server"/>
    <property name="LOG_ROOT_LEVEL" value="${E_PRINT_LOG_ROOT_LEVEL:-INFO}"/>
    <property name="GRAYLOG_HOST" value="${E_PRINT_GRAYLOG_HOST:-graylog.moco.com}"/>
    <property name="GRAYLOG_PORT" value="${E_PRINT_GRAYLOG_PORT:-12201}"/>
    <property name="GRAYLOG_ENV" value="PRD"/>
    <property name="INCLUDE_CALLER_DATA" value="false"/>

    <include resource="logback-base.xml"/>

    <!-- 非 LOC 控制台仅输出应用及基础组件的启动/初始化日志。 -->
    <logger name="com.eprint.server.EPrintServerApplication">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="org.springframework">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- ApiLogFilter 的 INFO 是请求日志；控制台只保留其初始化 DEBUG 日志。 -->
    <appender name="STARTUP_DEBUG_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_MSG}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-${native.encoding:-UTF-8}}</charset>
        </encoder>
    </appender>
    <logger name="com.eprint.server.config.ApiLogFilter">
        <appender-ref ref="STARTUP_DEBUG_STDOUT"/>
    </logger>
</configuration>
