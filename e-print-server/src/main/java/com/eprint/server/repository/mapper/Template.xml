<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eprint.server.repository.dao.TemplateDao">

    <resultMap type="com.eprint.server.repository.model.result.TemplateResult" id="templateResult">
        <result property="id" column="ID"/>
        <result property="templateType" column="TEMPLATE_TYPE"/>
        <result property="templateCode" column="TEMPLATE_CODE"/>
        <result property="bucketName" column="BUCKET_NAME"/>
        <result property="objectName" column="OBJECT_NAME"/>
        <result property="status" column="STATUS"/>
    </resultMap>

    <select id="getByTemplateCode"
            parameterType="com.eprint.server.repository.model.param.TemplateGetByCodeParam"
            resultMap="templateResult">
        SELECT
            T.ID,
            T.TEMPLATE_TYPE,
            T.TEMPLATE_CODE,
            T.BUCKET_NAME,
            T.OBJECT_NAME,
            T.STATUS
        FROM E_PRINT_TEMPLATE T
        WHERE T.TEMPLATE_TYPE = #{templateType}
          AND T.TEMPLATE_CODE = #{templateCode}
          AND T.STATUS = #{status}
    </select>
</mapper>
