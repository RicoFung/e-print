<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="e-print-admin"/>
    <property name="LOG_ROOT_LEVEL" value="${E_PRINT_LOG_ROOT_LEVEL:-INFO}"/>
    <property name="GRAYLOG_HOST" value="${E_PRINT_GRAYLOG_HOST:-grayloguat.moco.com}"/>
    <property name="GRAYLOG_PORT" value="${E_PRINT_GRAYLOG_PORT:-12201}"/>
    <property name="GRAYLOG_ENV" value="UAT"/>
    <property name="INCLUDE_CALLER_DATA" value="false"/>
    <include resource="logback-base.xml"/>

    <!-- 非 LOC 控制台仅输出应用及基础组件的启动/初始化日志。 -->
    <logger name="com.eprint.admin.EPrintAdminApplication">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="org.springframework">
        <appender-ref ref="STDOUT"/>
    </logger>
</configuration>
