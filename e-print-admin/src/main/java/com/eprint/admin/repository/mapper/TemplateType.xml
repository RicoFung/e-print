<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eprint.admin.repository.dao.TemplateTypeDao">

    <resultMap type="com.eprint.admin.repository.model.entity.TemplateType" id="templateTypeResult">
        <result property="id" column="ID"/>
        <result property="code" column="CODE"/>
        <result property="name" column="NAME"/>
        <result property="status" column="STATUS"/>
        <result property="sortNo" column="SORT_NO"/>
    </resultMap>

    <sql id="where">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    LOWER(T.CODE) LIKE '%' || LOWER(#{keyword}) || '%'
                    OR LOWER(T.NAME) LIKE '%' || LOWER(#{keyword}) || '%'
                )
            </if>
            <if test="status != null">
                AND T.STATUS = #{status}
            </if>
        </where>
    </sql>

    <sql id="order">
        <choose>
            <when test="sort != null and sort != ''">
                <foreach collection="sort.split(&quot;,&quot;, -1)"
                         item="item"
                         index="index"
                         separator=",">
                    <if test="index &lt; 4">
                        <choose>
                            <when test="'code.asc'.equals(item)">T.CODE ASC</when>
                            <when test="'code.desc'.equals(item)">T.CODE DESC</when>
                            <when test="'name.asc'.equals(item)">T.NAME ASC</when>
                            <when test="'name.desc'.equals(item)">T.NAME DESC</when>
                            <when test="'sortNo.asc'.equals(item)">T.SORT_NO ASC</when>
                            <when test="'sortNo.desc'.equals(item)">T.SORT_NO DESC</when>
                            <when test="'status.asc'.equals(item)">T.STATUS ASC</when>
                            <when test="'status.desc'.equals(item)">T.STATUS DESC</when>
                            <otherwise>T.SORT_NO ASC</otherwise>
                        </choose>
                    </if>
                </foreach>
                , T.SORT_NO ASC, T.ID ASC
            </when>
            <otherwise>T.SORT_NO ASC, T.ID ASC</otherwise>
        </choose>
    </sql>

    <select id="query"
            parameterType="com.eprint.admin.repository.model.param.TemplateTypeQueryParam"
            resultMap="templateTypeResult">
        SELECT
            ID,
            CODE,
            NAME,
            STATUS,
            SORT_NO
        FROM (
            SELECT
                T.ID,
                T.CODE,
                T.NAME,
                T.STATUS,
                T.SORT_NO,
                ROW_NUMBER() OVER (
                    ORDER BY <include refid="order"/>
                ) RN
            FROM E_PRINT_TEMPLATE_TYPE T
            <include refid="where"/>
        )
        WHERE RN &gt; (#{page} - 1) * #{pageSize}
          AND RN &lt;= #{page} * #{pageSize}
        ORDER BY RN
    </select>

    <select id="count"
            parameterType="com.eprint.admin.repository.model.param.TemplateTypeQueryParam"
            resultType="int">
        SELECT COUNT(1)
        FROM E_PRINT_TEMPLATE_TYPE T
        <include refid="where"/>
    </select>

    <select id="queryEnabled" resultMap="templateTypeResult">
        SELECT
            T.ID,
            T.CODE,
            T.NAME,
            T.STATUS,
            T.SORT_NO
        FROM E_PRINT_TEMPLATE_TYPE T
        WHERE T.STATUS = 1
        ORDER BY T.SORT_NO ASC, T.ID ASC
    </select>

    <select id="get" parameterType="string" resultMap="templateTypeResult">
        SELECT
            T.ID,
            T.CODE,
            T.NAME,
            T.STATUS,
            T.SORT_NO
        FROM E_PRINT_TEMPLATE_TYPE T
        WHERE T.ID = #{id}
    </select>

    <select id="getByCode" parameterType="string" resultMap="templateTypeResult">
        SELECT
            T.ID,
            T.CODE,
            T.NAME,
            T.STATUS,
            T.SORT_NO
        FROM E_PRINT_TEMPLATE_TYPE T
        WHERE T.CODE = #{code}
    </select>

    <insert id="create" parameterType="com.eprint.admin.repository.model.param.TemplateTypeCreateParam">
        INSERT INTO E_PRINT_TEMPLATE_TYPE (
            ID,
            CODE,
            NAME,
            STATUS,
            SORT_NO
        ) VALUES (
            SEQ_E_PRINT_TEMPLATE_TYPE.NEXTVAL,
            #{code},
            #{name},
            #{status},
            #{sortNo}
        )
    </insert>

    <update id="modify" parameterType="com.eprint.admin.repository.model.param.TemplateTypeModifyParam">
        UPDATE E_PRINT_TEMPLATE_TYPE
        SET
            CODE = #{code},
            NAME = #{name},
            STATUS = #{status},
            SORT_NO = #{sortNo}
        WHERE ID = #{id}
    </update>

    <update id="disable" parameterType="com.eprint.admin.repository.model.param.TemplateTypeDisableParam">
        UPDATE E_PRINT_TEMPLATE_TYPE
        SET STATUS = 0
        WHERE ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="enable" parameterType="com.eprint.admin.repository.model.param.TemplateTypeEnableParam">
        UPDATE E_PRINT_TEMPLATE_TYPE
        SET STATUS = 1
        WHERE ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="remove" parameterType="com.eprint.admin.repository.model.param.TemplateTypeRemoveParam">
        DELETE FROM E_PRINT_TEMPLATE_TYPE
        WHERE ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countTemplates" parameterType="string" resultType="int">
        SELECT COUNT(1)
        FROM E_PRINT_TEMPLATE T
        WHERE T.TEMPLATE_TYPE_ID = #{id}
    </select>
</mapper>
